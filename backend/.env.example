# ============================================================
# DevPilot AI - Backend environment configuration
# ============================================================
# Copy this file as ".env" and replace the placeholder values.
#
# IMPORTANT:
# - Never commit the real .env file.
# - Never store API keys, passwords or JWT secrets in Git.
# ============================================================


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=postgresql+psycopg://devpilot_user:devpilot_password@localhost:5432/devpilot


# ------------------------------------------------------------
# OpenAI / RAG
# ------------------------------------------------------------

OPENAI_API_KEY=your_openai_api_key_here

RAG_MODEL=your_model_name_here


# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------

JWT_SECRET_KEY=replace_with_a_long_random_secret

JWT_ALGORITHM=HS256

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60